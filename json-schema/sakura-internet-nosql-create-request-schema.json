            },
            "Storage": {
              "type": [
                "string",
                "null"
              ],
              "description": "ストレージ  \n**新規作成時必須**\n",
              "enum": [
                "SSD"
              ]
            },
            "Virtualcore": {
              "type": [
                "integer",
                "null"
              ],
              "description": "仮想コア  \n未指定時はプランから自動設定  \n"
            },
            "Zone": {
              "type": "string",
              "description": "ゾーン  \n**新規作成時・ノード追加時必須**\n"
