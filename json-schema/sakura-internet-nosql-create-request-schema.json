    "NosqlSettings": {
      "type": "object",
      "properties": {
        "Password": {
          "$ref": "#/$defs/Password"
        },
        "ReserveIPAddress": {
          "description": "予備IPアドレス  \n**新規作成時・ノード追加時必須**  \n※デッドノード発生時、ノード切替を行う際に使用する予備のIPアドレス  \nただし、40GBプランの場合は必須ではありません。\n",
          "type": "string",
          "format": "ipv4"
        },
        "Backup": {
          "type": [
            "object",
            "null"
          ],
          "description": "バックアップ情報",
          "properties": {
            "Connect": {
              "type": "string",
              "description": "バックアップ先（NFS URL形式）",
              "pattern": "^(nfs://[0-9\\.]+/[A-Za-z0-9_\\-\\/]+)$"
            },
            "DayOfWeek": {
              "type": [
                "array",
                "null"
              ],
              "description": "バックアップスケジュール",
              "items": {
                "type": "string",
                "enum": [
                  "sun",
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat"
                ]
              }
            },
            "Time": {
              "type": [
                "string",
                "null"
              ],
              "description": "バックアップする時間",
              "pattern": "^(([0-1][0-9]|2[0-3]):(00|15|30|45))?$"
            },
            "Rotate": {
              "type": "integer",
              "description": "バックアップ数（1から8まで）",
              "minimum": 1,
              "maximum": 8
            }
          },
          "required": [
            "Connect",
            "Rotate"
          ]
        },
        "SourceNetwork": {
          "type": "array",
          "description": "送信元ネットワークアドレス",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?:/(?:[0-9]|[1-2][0-9]|3[0-2]))?$"
          }
        },
        "Repair": {
          "type": [
            "object",
            "null"
          ],
          "description": "定期リペア設定  \n※40GBプランはノード数が1のため、リペア設定を行うことはできません。 \n",
          "properties": {
            "Incremental": {
              "type": "object",
              "description": "増分リペア設定",
              "properties": {
                "DaysOfWeek": {
                  "type": "array",
                  "description": "実行曜日",
                  "items": {
                    "type": "string",
                    "enum": [
                      "sun",
                      "mon",
                      "tue",
                      "wed",
                      "thu",
                      "fri",
                      "sat"
                    ]
                  }
                },
                "Time": {
                  "type": "string",
                  "description": "実行時間",
                  "pattern": "^(([0-1][0-9]|2[0-3]):(00|15|30|45))?$"
                }
              },
              "required": [
                "DaysOfWeek",
                "Time"
              ]
            },
            "Full": {
              "type": "object",
              "description": "完全リペア設定",
              "properties": {
                "Interval": {
                  "type": "integer",
                  "description": "7日ごとの実行間隔（日数）",
                  "enum": [
                    7,
                    14,
                    21,
                    28
                  ]
                },
                "DayOfWeek": {
                  "type": "string",
                  "description": "実行曜日",
                  "enum": [
                    "sun",
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat"
                  ]
                },
                "Time": {
                  "type": "string",
                  "description": "実行時間",
                  "pattern": "^(([0-1][0-9]|2[0-3]):(00|15|30|45))?$"
                }
              },
              "required": [
                "Interval",
                "DayOfWeek",
                "Time"
              ]
            }
          }
        }
      }
    },
    "Password": {
      "type": "string",
      "description": "パスワード  \n**新規作成時必須**\n",
      "pattern": "^[a-zA-Z0-9-._]+$",
      "minLength": 12,
      "maxLength": 30
    },
    "Plan": {
      "type": "object",
      "description": "プラン  \n**新規作成時・ノード追加時必須**\n",
      "properties": {
        "ID": {
          "type": "integer",
          "description": "プランID  \n**新規作成時・ノード追加時必須**\n\n利用可能なプランID:\n| プラン名      | プランID   | \n|--------------|------------|\n| 40GBプラン       |   51142    |\n| 100GBプラン       |   51143    |\n| 100GBプラン/ノード |   51145    |\n| 250GBプラン       |   51144    |\n| 250GBプラン/ノード |   51146    |\n"
        }
      },
      "required": [
        "ID"
      ]
    },
    "ServiceClass": {
      "type": "string",
      "description": "サービスクラス  \n**新規作成時・ノード追加時必須**\n\n| プラン名      | サービスクラスパス          | \n|--------------|----------------------------|\n| 40GBプラン       |  cloud/nosql/plan/1        |\n| 100GBプラン       |  cloud/nosql/plan/2        |\n| 100GBプラン/ノード |  cloud/nosql/plan/2/node  |\n| 250GBプラン       |  cloud/nosql/plan/3        |\n| 250GBプラン/ノード |  cloud/nosql/plan/3/node  |\n"
    },
    "Tags": {
      "type": [
        "array",
        "null"
      ],
      "description": "タグ",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 32,
        "pattern": "^[^\\s\\u3000]+$"
      }
    }
  }
}